# ==============================================================================
# ABC CAR SHOWROOM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# In Vercel, configure these variables under Project Settings -> Environment Variables.

# ------------------------------------------------------------------------------
# 1. BROWSER-SAFE CLIENT VARIABLES (Vite builds into frontend bundle)
# ------------------------------------------------------------------------------
# Supabase project URL (e.g., https://xxxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# Supabase public anonymous / publishable key (safe for public client code with RLS)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Public site canonical base URL (e.g. http://localhost:3000 or https://your-domain.vercel.app)
VITE_PUBLIC_SITE_URL=

# Demo mode toggle (true = displays banner, false = production). Defaults to false.
VITE_DEMO_MODE=false

# Google reCAPTCHA v3 public site key (optional for client-side forms)
VITE_RECAPTCHA_SITE_KEY=

# Web Push VAPID public key (optional for browser push notifications)
VITE_VAPID_PUBLIC_KEY=


# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (Vercel Serverless Functions & Backend ONLY)
# ------------------------------------------------------------------------------
# CRITICAL SECURITY RULES:
# - NEVER prefix these with VITE_
# - NEVER import or reference these inside src/ or any frontend code
# - NEVER commit real values to Git
# ------------------------------------------------------------------------------

# Supabase URL for serverless functions (defaults to same Supabase project URL)
SUPABASE_URL=

# Supabase Service Role Key (bypasses RLS - STRICTLY CONFIDENTIAL SERVER-ONLY)
SUPABASE_SERVICE_ROLE_KEY=

# Secret token used for initial super_admin bootstrap / setup verification
BOOTSTRAP_SECRET=

# Google reCAPTCHA v3 secret key for backend verification
RECAPTCHA_SECRET_KEY=

# Web Push VAPID private key
VAPID_PRIVATE_KEY=

# Web Push VAPID subject (e.g., mailto:admin@example.com)
VAPID_SUBJECT=

# Shared secret header to authorize scheduled cron job invocations
CRON_SECRET=

# (Optional) AI / LLM API key for server-side processing
AI_API_KEY=

# (Optional) Vercel Blob storage read/write token
BLOB_READ_WRITE_TOKEN=
